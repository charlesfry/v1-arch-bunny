#!/usr/bin/env bash
# disk-qgroup-usage — read-only root helper for disk-usage-alert.
# Emits one line per btrfs qgroup, plus snapper's qgroup usage against its
# SPACE_LIMIT budget, all in raw bytes. Root only because `btrfs qgroup show`
# requires it; writes nothing.
set -Eeuo pipefail

# Every qgroup, with its referenced bytes. This used to filter on qgroups
# carrying a max_referenced cap, which stopped working the moment question 26
# dropped the caps (2026-08-26) — the filter matched nothing and the meter went
# silently blind. The helper stays dumb: it reports, the caller decides what to
# watch and against which number.
btrfs qgroup show -re --raw / 2>/dev/null | awk '
  $1 ~ /^0\// {
    # `@containerd` reads better as `containerd`, but the root subvolume is
    # named `@` and stripping that leaves an empty path (which is a hard error
    # as a bash array subscript downstream -- found 2026-08-26).
    path = $6; if (path != "@") sub(/^@/, "", path)
    printf "qgroup path=%s ref=%s\n", path, $2
  }'

# Snapper enforces its cap at cleanup time as SPACE_LIMIT x filesystem size
# on the exclusive bytes of its qgroup (1/0 here); report the same numbers
# it uses so the alert fires before cleanup pressure becomes an ENOSPC.
qg=$(sed -n 's/^QGROUP="\(.*\)"/\1/p' /etc/snapper/configs/root)
sl=$(sed -n 's/^SPACE_LIMIT="\(.*\)"/\1/p' /etc/snapper/configs/root)
if [[ -n "$qg" ]]; then
	excl=$(btrfs qgroup show --raw / 2>/dev/null | awk -v q="$qg" '$1 == q { print $3 }')
	fssize=$(df -B1 --output=size / | tail -1 | tr -d ' ')
	budget=$(awk -v s="$fssize" -v f="${sl:-0.5}" 'BEGIN { printf "%.0f", s * f }')
	count=$(snapper --no-headers -c root list 2>/dev/null | wc -l)
	echo "snapper excl=${excl:-0} budget=${budget} count=${count}"
fi
