# Bunny Plymouth theme. CHOICES.md `boot-splash` (bunny lock-screen's sibling,
# CHOICES.md `lock-idle`). Adapted from Arch's own stock example theme at
# /usr/share/plymouth/themes/script/script.script (ModuleName=script).
#
# No background image right now. A full-screen Image()-loaded background
# sprite -- tried both runtime-scaled from a 1920x1080 source and pre-scaled
# to this machine's native 2880x1920 -- reliably prevented the password
# dialog from ever reaching the screen on a real boot, even though the exact
# same dialog code renders correctly the moment any background image sprite
# is removed (proven by isolating each piece separately: stock dialog code
# alone works, our dialog code with no background works, either background
# variant breaks it). Root cause not yet found; the background is parked
# rather than guessed at further. See CHOICES.md `boot-splash` for the
# investigation.
#
# box.png / lock.png / entry.png / bullet.png are copied verbatim from the
# stock theme -- Arch's own UI chrome, not hand-drawn here. The username
# label and "Enter password to unlock" prompt are the only text drawn
# ourselves (Image.Text), added because the stock dialog is otherwise a box
# with no caption -- legible once you know what it is, not obviously an
# input to type into on first sight.

Window.SetBackgroundTopColor(0.06, 0.06, 0.06);
Window.SetBackgroundBottomColor(0.06, 0.06, 0.06);

#----------------------------------------- Password dialog --------------------------------

status = "normal";

fun dialog_setup()
  {
    local.box;
    local.lock;
    local.entry;
    local.username;
    local.prompt;

    box.image = Image("box.png");
    lock.image = Image("lock.png");
    entry.image = Image("entry.png");

    box.sprite = Sprite(box.image);
    box.x = Window.GetX() + Window.GetWidth()  / 2 - box.image.GetWidth ()/2;
    box.y = Window.GetY() + Window.GetHeight() / 2 - box.image.GetHeight()/2;
    box.z = 10000;
    box.sprite.SetPosition(box.x, box.y, box.z);

    lock.sprite = Sprite(lock.image);
    lock.x = box.x + box.image.GetWidth()/2 - (lock.image.GetWidth() + entry.image.GetWidth()) / 2;
    lock.y = box.y + box.image.GetHeight()/2 - lock.image.GetHeight()/2;
    lock.z = box.z + 1;
    lock.sprite.SetPosition(lock.x, lock.y, lock.z);

    entry.sprite = Sprite(entry.image);
    entry.x = lock.x + lock.image.GetWidth();
    entry.y = box.y + box.image.GetHeight()/2 - entry.image.GetHeight()/2;
    entry.z = box.z + 1;
    entry.sprite.SetPosition(entry.x, entry.y, entry.z);

    # @USER@ is substituted at install time by install.d/45-plymouth.sh, same
    # convention as 60-autologin.sh's getty drop-in -- never hardcode a
    # specific username, CLAUDE.md's own rule for this exact class of file.
    # Accent color matches niri's #7fc8ff (0.498, 0.784, 1.0).
    username.image = Image.Text("@USER@", 0.498, 0.784, 1.0);
    username.sprite = Sprite(username.image);
    username.x = box.x + box.image.GetWidth()/2 - username.image.GetWidth()/2;
    username.y = box.y - username.image.GetHeight() - 10;
    username.z = box.z + 1;
    username.sprite.SetPosition(username.x, username.y, username.z);

    # The box+lock+entry above is the input itself; nothing said what it was
    # for. Same accent color and Image.Text approach as username, placed below
    # the box so it reads as a caption for the whole dialog, not just the entry.
    prompt.image = Image.Text("Enter password to unlock", 0.498, 0.784, 1.0);
    prompt.sprite = Sprite(prompt.image);
    prompt.x = box.x + box.image.GetWidth()/2 - prompt.image.GetWidth()/2;
    prompt.y = box.y + box.image.GetHeight() + 10;
    prompt.z = box.z + 1;
    prompt.sprite.SetPosition(prompt.x, prompt.y, prompt.z);

    global.dialog.box = box;
    global.dialog.lock = lock;
    global.dialog.entry = entry;
    global.dialog.username = username;
    global.dialog.prompt = prompt;
    global.dialog.bullet_image = Image("bullet.png");
    dialog_opacity(1);
  }

fun dialog_opacity(opacity)
  {
    dialog.box.sprite.SetOpacity(opacity);
    dialog.lock.sprite.SetOpacity(opacity);
    dialog.entry.sprite.SetOpacity(opacity);
    dialog.username.sprite.SetOpacity(opacity);
    dialog.prompt.sprite.SetOpacity(opacity);
    for (index = 0; dialog.bullet[index]; index++)
      {
        dialog.bullet[index].sprite.SetOpacity(opacity);
      }
  }

fun display_normal_callback()
  {
    global.status = "normal";
    if (global.dialog)
      dialog_opacity(0);
  }

fun display_password_callback(prompt, bullets)
  {
    global.status = "password";
    if (!global.dialog)
      dialog_setup();
    else
      dialog_opacity(1);
    for (index = 0; dialog.bullet[index] || index < bullets; index++)
      {
        if (!dialog.bullet[index])
          {
            dialog.bullet[index].sprite = Sprite(dialog.bullet_image);
            dialog.bullet[index].x = dialog.entry.x + index * dialog.bullet_image.GetWidth();
            dialog.bullet[index].y = dialog.entry.y + dialog.entry.image.GetHeight() / 2 - dialog.bullet_image.GetHeight() / 2;
            dialog.bullet[index].z = dialog.entry.z + 1;
            dialog.bullet[index].sprite.SetPosition(dialog.bullet[index].x, dialog.bullet[index].y, dialog.bullet[index].z);
          }
        if (index < bullets)
          dialog.bullet[index].sprite.SetOpacity(1);
        else
          dialog.bullet[index].sprite.SetOpacity(0);
      }
  }

Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
