[Unit]
Description=PolicyKit authentication agent
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
# The package ships an XDG autostart file, but nothing under niri runs XDG
# autostart, so the agent has to be started explicitly or every privileged
# prompt fails silently. Path verified against the package file list, not
# assumed -- the predecessor's mate-polkit agent was gated OnlyShowIn=MATE and
# never fired at all.
ExecStart=/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
Restart=on-failure

[Install]
WantedBy=graphical-session.target
